	"authors": ["You"],
	"license": "CC0-1.0",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.tiktokinventory.TikTokInventoryClient"]
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"mcef-modern": "*"
	}
}
